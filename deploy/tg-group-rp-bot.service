[Unit]
Description=Telegram group roleplay bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=tg-group-rp-bot
Group=tg-group-rp-bot
WorkingDirectory=/var/lib/tg-group-rp-bot
EnvironmentFile=/etc/tg-group-rp-bot.env
Environment=UV_CACHE_DIR=/var/cache/tg-group-rp-bot
Environment=UV_PYTHON_INSTALL_DIR=/var/lib/tg-group-rp-bot/python
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/local/bin/uv run --locked --script /opt/tg-group-rp-bot/bot.py --model deepseek/deepseek-v4.1-flash --log-file /var/log/tg-group-rp-bot/bot.log
StateDirectory=tg-group-rp-bot
CacheDirectory=tg-group-rp-bot
LogsDirectory=tg-group-rp-bot
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
